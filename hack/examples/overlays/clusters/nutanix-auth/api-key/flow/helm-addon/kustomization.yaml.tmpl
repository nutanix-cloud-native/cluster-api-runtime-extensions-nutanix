apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
- ../../../../nutanix/flow/helm-addon

patches:
- target:
    kind: Secret
    name: '\$\{CLUSTER_NAME\}-pc-creds'
  path: ../../../../../../patches/nutanix-auth/api-key/pc-credentials-secret.yaml
- target:
    kind: Secret
    name: '\$\{CLUSTER_NAME\}-pc-creds-for-csi'
  path: ../../../../../../patches/nutanix-auth/api-key/pc-credentials-for-csi-secret.yaml
- target:
    kind: Secret
    name: '\$\{CLUSTER_NAME\}-pc-creds-for-konnector-agent'
  path: ../../../../../../patches/nutanix-auth/api-key/pc-credentials-for-konnector-agent-secret.yaml
